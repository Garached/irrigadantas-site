# Modelo das variáveis de ambiente. NÃO coloque valores reais aqui.
# Para usar no seu computador: copie este arquivo para ".env.local" e preencha.
# Na Vercel: Project Settings > Environment Variables.

# Chave de API do Resend (https://resend.com) — SECRETA
RESEND_API_KEY=

# E-mail que RECEBE os pedidos de orçamento.
# Por enquanto: o seu e-mail pessoal. Depois: troque pelo e-mail da empresa
# (irrigadantas@irrigadantas.com.br), no .env.local e na Vercel. Não precisa mudar código.
QUOTE_TO_EMAIL=

# Remetente do e-mail. Só funciona com domínio verificado no Resend.
# Se ficar vazio, usa o remetente de teste do Resend (onboarding@resend.dev),
# que só entrega para o e-mail dono da conta Resend.
QUOTE_FROM_EMAIL=

# Libera o site para o Google e outros buscadores. Não é secreta.
# Vazio (padrão): site BLOQUEADO pela meta "noindex" em todas as páginas, para o endereço provisório.
# (O robots.txt fica sempre liberado, para o Google conseguir ler o "noindex".)
# No lançamento oficial: ALLOW_INDEXING=true na Vercel (ambiente Production) e faça um Redeploy.
# No seu computador, deixe vazio.
ALLOW_INDEXING=
